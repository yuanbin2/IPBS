DJANGO_SECRET_KEY=change-me-in-local-dev-with-at-least-32-bytes
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
APP_TIMEZONE=Asia/Shanghai
AGENT_SECURITY_ENFORCED=true
# start.bat/start.sh set this to true automatically. Keep false in Docker.
BLOG_LOCAL_MODE=false
DATABASE_URL=postgres://postgres:postgres@postgres:5432/knowledge_agent
RAG_VECTOR_BACKEND=pgvector
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
RABBITMQ_URL=amqp://blog:blog@rabbitmq:5672/blog
RABBITMQ_USER=blog
RABBITMQ_PASSWORD=change-me-before-deploy
RABBITMQ_VHOST=blog
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
POSTGRES_DB=knowledge_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-before-deploy
POSTGRES_PORT=5432
REDIS_PORT=6379
NGINX_PORT=80
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=knowledge-agent-local
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=knowledge-agent-local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://poloai.top/v1/
OPENAI_MODEL=gpt-4o-mini
BAILIAN_API_KEY=
BAILIAN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_EMBEDDING_MODEL=text-embedding-v1
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_TIMEOUT_SECONDS=10
# Optional, for Windows/local networks that require a proxy, e.g. http://127.0.0.1:7890
WEB_SEARCH_PROXY=
