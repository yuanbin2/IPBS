# Non-local example. Compose's HTTP listener binds to host loopback and requires
# a verified TLS-terminating proxy. Fill secrets privately; never commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=
DJANGO_HTTPS_TERMINATED=
DJANGO_CSRF_TRUSTED_ORIGINS=
APP_TIMEZONE=Asia/Shanghai
AGENT_SECURITY_ENFORCED=true
# For cross-origin frontend hosting (for example, Cloudflare Pages), set the exact HTTPS origin in Railway.
DJANGO_CORS_ALLOWED_ORIGINS=
# start.bat/start.sh set this to true automatically. Keep false in Docker.
BLOG_LOCAL_MODE=false
# Leave unset for environment-based default: local mode uses files; non-local
# direct deployments require s3 configuration. Docker Compose explicitly uses
# file storage backed by its media_data volume unless overridden.
BLOG_MEDIA_BUCKET_NAME=
BLOG_MEDIA_ENDPOINT=
BLOG_MEDIA_REGION=
BLOG_MEDIA_ACCESS_KEY_ID=
BLOG_MEDIA_SECRET_ACCESS_KEY=
# Authenticated private-note images: absolute persistent directory outside the public MEDIA_ROOT.
# Mount a dedicated volume here in production; never point this inside /media/.
BLOG_PRIVATE_NOTE_MEDIA_ROOT=
# Direct deployments set DATABASE_URL, REDIS_URL, REDIS_CACHE_URL and RABBITMQ_URL;
# percent-encode reserved characters in those URL password components.
# Compose constructs PostgreSQL/RabbitMQ URLs from the raw fields below: use
# URL-safe passwords (letters, digits, hyphen, underscore) for these fields.
DATABASE_URL=
RAG_VECTOR_BACKEND=pgvector
REDIS_URL=
REDIS_CACHE_URL=
RABBITMQ_URL=
RABBITMQ_USER=blog_app
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=blog
# These ports are used only with docker-compose.debug.yml, bound to 127.0.0.1.
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
POSTGRES_DB=knowledge_agent
POSTGRES_USER=blog_app
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379
# HTTP origin for a host-local TLS proxy; not a public HTTP listener.
NGINX_PORT=8080
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=knowledge-agent-local
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=knowledge-agent-local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://poloai.top/v1/
OPENAI_MODEL=gpt-4o-mini
# Optional terminal-failure alert recipients. Configure an SMTP email backend
# separately for delivery; with this empty, failures remain ERROR console logs.
AGENT_ALERT_EMAILS=
AGENT_ALERT_FROM_EMAIL=agent-alert@localhost
AGENT_ALERT_SMTP_HOST=localhost
AGENT_ALERT_SMTP_PORT=25
AGENT_ALERT_SMTP_USER=
AGENT_ALERT_SMTP_PASSWORD=
AGENT_ALERT_SMTP_TLS=false
AGENT_ALERT_SMTP_TIMEOUT=3
# Model prices are opt-in. JSON fields: version, currency, units_per_token_price,
# models.<exact model name>.input/output. Prices are per configured token unit.
# Example (replace with your own verified tariff and version):
# AGENT_MODEL_PRICES_JSON={"version":"provider-YYYY-MM-DD","currency":"USD","units_per_token_price":1000000,"models":{"your-model":{"input":"1.00","output":"2.00"}}}
# 博客写作助手专用配置；留空时分别回退到上面的 OPENAI_* 配置。
BLOG_WRITING_AGENT_API_KEY=
BLOG_WRITING_AGENT_BASE_URL=
BLOG_WRITING_AGENT_MODEL=
BAILIAN_API_KEY=
BAILIAN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_EMBEDDING_MODEL=text-embedding-v1
RAG_EMBEDDING_MODE=local_hash
# Set remote in production only after pinning the provider's model release.
RAG_EMBEDDING_MODEL_VERSION=
RAG_EMBEDDING_ALGORITHM_VERSION=provider-api-v1
RAG_EMBEDDING_DIMENSIONS=
RAG_EMBEDDING_NORMALIZED=false
RAG_CORPUS_VERSION=corpus-v1
RAG_INDEX_VERSION=index-v1
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_TIMEOUT_SECONDS=10
# Optional, for Windows/local networks that require a proxy, e.g. http://127.0.0.1:7890
WEB_SEARCH_PROXY=
