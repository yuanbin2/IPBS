const __vite__css = "/* ============================================================\n   Design System — Enterprise Knowledge Agent Platform\n   ============================================================\n   Color palette: Deep sea teal + copper accent\n   Font: Inter / PingFang SC / Microsoft YaHei / Noto Sans SC\n   ============================================================ */\n\n/* --- Design Tokens --------------------------------------------------- */\n:root {\n  /* Brand — Primary */\n  --color-primary: #276678;\n  --color-primary-hover: #205767;\n  --color-primary-active: #194754;\n  --color-primary-soft: #e8f1f3;\n  --color-primary-border: #b9d1d7;\n\n  /* Brand — Accent (use sparingly) */\n  --color-accent: #b86f43;\n  --color-accent-hover: #9f5d36;\n  --color-accent-soft: #f7ece5;\n\n  /* Neutrals */\n  --color-bg-page: #f4f6f7;\n  --color-bg-surface: #ffffff;\n  --color-bg-sidebar: #17262e;\n  --color-bg-sidebar-hover: #223740;\n  --color-text-primary: #182329;\n  --color-text-secondary: #56646c;\n  --color-text-muted: #849199;\n  --color-border: #dce3e6;\n  --color-divider: #e8ecee;\n  --color-disabled-bg: #eff2f3;\n  --color-disabled-text: #a5afb4;\n\n  /* Status */\n  --color-success: #2f7d5c;\n  --color-success-soft: #e8f5ee;\n  --color-warning: #b7791f;\n  --color-warning-soft: #fef9e7;\n  --color-danger: #b64b4b;\n  --color-danger-soft: #fce8e8;\n  --color-info: #3f6fa8;\n  --color-info-soft: #eaf0f8;\n\n  /* Typography */\n  --font-family: Inter, \"PingFang SC\", \"Microsoft YaHei\", \"Noto Sans SC\", Arial, sans-serif;\n  --font-mono: \"JetBrains Mono\", Consolas, \"Courier New\", monospace;\n  --font-size-xs: 12px;\n  --font-size-sm: 13px;\n  --font-size-base: 14px;\n  --font-size-md: 15px;\n  --font-size-lg: 16px;\n  --font-size-xl: 18px;\n  --font-size-2xl: 22px;\n  --font-size-3xl: 28px;\n\n  /* Spacing (4px base) */\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-5: 20px;\n  --space-6: 24px;\n  --space-8: 32px;\n  --space-10: 40px;\n  --space-12: 48px;\n\n  /* Border Radius */\n  --radius-sm: 4px;\n  --radius-md: 6px;\n  --radius-lg: 8px;\n  --radius-xl: 10px;\n\n  /* Shadows */\n  --shadow-sm: 0 1px 2px rgba(24, 35, 41, 0.04);\n  --shadow-md: 0 2px 8px rgba(24, 35, 41, 0.08);\n  --shadow-lg: 0 8px 24px rgba(24, 35, 41, 0.12);\n\n  /* Transitions */\n  --transition-fast: 150ms ease;\n  --transition-base: 200ms ease;\n\n  /* Layout */\n  --sidebar-width: 240px;\n  --topbar-height: 56px;\n\n  /* Element Plus overrides */\n  --el-color-primary: #276678;\n  --el-color-primary-light-3: #4a8a9c;\n  --el-color-primary-light-5: #7bafbd;\n  --el-color-primary-light-7: #a8ced6;\n  --el-color-primary-light-8: #c5dde3;\n  --el-color-primary-light-9: #e8f1f3;\n  --el-color-primary-dark-2: #205767;\n  --el-color-success: #2f7d5c;\n  --el-color-warning: #b7791f;\n  --el-color-danger: #b64b4b;\n  --el-color-info: #3f6fa8;\n  --el-color-danger-light-3: #cc7070;\n  --el-color-danger-light-5: #d99999;\n  --el-color-danger-light-7: #e6b8b8;\n  --el-color-danger-light-8: #f0d0d0;\n  --el-color-danger-light-9: #fce8e8;\n  --el-color-danger-dark-2: #923c3c;\n  --el-border-radius-base: 6px;\n  --el-border-radius-small: 4px;\n  --el-border-radius-round: 999px;\n  --el-font-size-base: 14px;\n  --el-font-size-small: 13px;\n  --el-font-size-extra-small: 12px;\n  --el-border-color: #dce3e6;\n  --el-border-color-light: #e8ecee;\n  --el-border-color-lighter: #eff2f3;\n  --el-fill-color-blank: #ffffff;\n  --el-fill-color-light: #f4f6f7;\n  --el-text-color-primary: #182329;\n  --el-text-color-regular: #56646c;\n  --el-text-color-secondary: #849199;\n  --el-text-color-placeholder: #a5afb4;\n  --el-bg-color: #f4f6f7;\n  --el-bg-color-page: #f4f6f7;\n  --el-mask-color: rgba(24, 35, 41, 0.5);\n}\n\n/* --- Global Reset & Base -------------------------------------------- */\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nhtml {\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  text-rendering: optimizeLegibility;\n}\n\nbody {\n  margin: 0;\n  padding: 0;\n  color: var(--color-text-primary);\n  background: var(--color-bg-page);\n  font-family: var(--font-family);\n  font-size: var(--font-size-base);\n  line-height: 1.6;\n}\n\na {\n  color: var(--color-primary);\n  text-decoration: none;\n}\n\na:hover {\n  color: var(--color-primary-hover);\n}\n\nh1, h2, h3, h4, h5, h6 {\n  margin: 0;\n  color: var(--color-text-primary);\n  font-weight: 600;\n  line-height: 1.35;\n}\n\np {\n  margin: 0;\n}\n\nimg {\n  max-width: 100%;\n  height: auto;\n}\n\n/* Focus visibility */\n:focus-visible {\n  outline: 2px solid var(--color-primary);\n  outline-offset: 2px;\n}\n\n/* Scrollbar */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n::-webkit-scrollbar-thumb {\n  background: var(--color-border);\n  border-radius: 3px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: var(--color-text-muted);\n}\n\n/* --- App Shell Layout ----------------------------------------------- */\n.shell {\n  display: flex;\n  min-height: 100vh;\n  background: var(--color-bg-page);\n}\n\n/* --- Sidebar -------------------------------------------------------- */\n.sidebar {\n  position: fixed;\n  inset: 0 auto 0 0;\n  z-index: 100;\n  display: flex;\n  flex-direction: column;\n  width: var(--sidebar-width);\n  background: var(--color-bg-sidebar);\n  color: #d6e2e6;\n  overflow-y: auto;\n}\n\n.sidebar-header {\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  padding: var(--space-5) var(--space-5) var(--space-6);\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n.sidebar-logo {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 36px;\n  height: 36px;\n  border-radius: var(--radius-lg);\n  background: var(--color-primary);\n  color: #ffffff;\n  font-size: 18px;\n  font-weight: 700;\n  flex-shrink: 0;\n}\n\n.sidebar-brand {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n}\n\n.sidebar-brand strong {\n  display: block;\n  color: #ffffff;\n  font-size: var(--font-size-base);\n  font-weight: 600;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.sidebar-brand small {\n  color: #8ba3ac;\n  font-size: var(--font-size-xs);\n}\n\n/* Navigation */\n.nav {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-1);\n  padding: var(--space-4) var(--space-3);\n  flex: 1;\n}\n\n.nav a {\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  padding: 10px 12px;\n  border-radius: var(--radius-md);\n  color: #a9bfc8;\n  font-size: var(--font-size-base);\n  transition: color var(--transition-fast), background var(--transition-fast);\n  position: relative;\n  text-decoration: none;\n}\n\n.nav a .el-icon {\n  font-size: 18px;\n  flex-shrink: 0;\n}\n\n.nav a:hover {\n  color: #ffffff;\n  background: var(--color-bg-sidebar-hover);\n}\n\n.nav a.active {\n  color: #ffffff;\n  background: rgba(39, 102, 120, 0.35);\n}\n\n.nav a.active::before {\n  content: \"\";\n  position: absolute;\n  left: 0;\n  top: 8px;\n  bottom: 8px;\n  width: 3px;\n  border-radius: 0 2px 2px 0;\n  background: var(--color-primary);\n}\n\n/* Account box */\n.account-box {\n  margin-top: auto;\n  border-top: 1px solid rgba(255, 255, 255, 0.08);\n  padding: var(--space-4) var(--space-4);\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n}\n\n.account-avatar {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 34px;\n  height: 34px;\n  border-radius: var(--radius-md);\n  background: rgba(39, 102, 120, 0.3);\n  color: #ffffff;\n  font-size: 16px;\n  flex-shrink: 0;\n}\n\n.account-info {\n  flex: 1;\n  min-width: 0;\n}\n\n.account-info strong {\n  display: block;\n  color: #ffffff;\n  font-size: var(--font-size-sm);\n  font-weight: 600;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.account-info span {\n  display: block;\n  color: #8ba3ac;\n  font-size: var(--font-size-xs);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.account-logout {\n  border: 0;\n  border-radius: var(--radius-md);\n  background: rgba(255, 255, 255, 0.1);\n  color: #a9bfc8;\n  cursor: pointer;\n  padding: 6px 10px;\n  font-size: var(--font-size-xs);\n  transition: background var(--transition-fast), color var(--transition-fast);\n  flex-shrink: 0;\n}\n\n.account-logout:hover {\n  background: rgba(182, 75, 75, 0.3);\n  color: #f0d0d0;\n}\n\n/* --- Mobile sidebar toggle ------------------------------------------ */\n.mobile-nav-toggle {\n  display: none;\n  position: fixed;\n  top: 12px;\n  left: 12px;\n  z-index: 110;\n  width: 40px;\n  height: 40px;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  background: var(--color-bg-surface);\n  color: var(--color-text-primary);\n  cursor: pointer;\n  font-size: 20px;\n  align-items: center;\n  justify-content: center;\n  box-shadow: var(--shadow-md);\n}\n\n/* Sidebar overlay for mobile */\n.sidebar-overlay {\n  display: none;\n}\n\n/* --- Workspace & Topbar --------------------------------------------- */\n.workspace {\n  flex: 1;\n  margin-left: var(--sidebar-width);\n  display: flex;\n  flex-direction: column;\n  min-height: 100vh;\n}\n\n.topbar {\n  position: sticky;\n  top: 0;\n  z-index: 50;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-4);\n  height: var(--topbar-height);\n  padding: 0 var(--space-8);\n  background: var(--color-bg-surface);\n  border-bottom: 1px solid var(--color-divider);\n  flex-shrink: 0;\n}\n\n.topbar-left {\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  min-width: 0;\n}\n\n.topbar-left h1 {\n  font-size: var(--font-size-lg);\n  font-weight: 600;\n  white-space: nowrap;\n}\n\n.topbar-breadcrumb {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n  color: var(--color-text-muted);\n  font-size: var(--font-size-sm);\n}\n\n.topbar-breadcrumb span {\n  color: var(--color-text-secondary);\n}\n\n.topbar-right {\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  flex-shrink: 0;\n}\n\n.main-content {\n  flex: 1;\n  padding: var(--space-6) var(--space-8);\n}\n\n/* --- Page Header Pattern -------------------------------------------- */\n.page-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--space-6);\n  margin-bottom: var(--space-6);\n}\n\n.page-header h1 {\n  font-size: var(--font-size-2xl);\n  font-weight: 600;\n  margin-bottom: var(--space-2);\n}\n\n.page-header p {\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-md);\n}\n\n.page-header-actions {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n  flex-shrink: 0;\n}\n\n/* --- Card Component ------------------------------------------------- */\n.card {\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  background: var(--color-bg-surface);\n  box-shadow: var(--shadow-sm);\n  padding: var(--space-5);\n}\n\n.card-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-3);\n  margin-bottom: var(--space-4);\n}\n\n.card-header h2 {\n  font-size: var(--font-size-lg);\n  font-weight: 600;\n}\n\n.card-header h3 {\n  font-size: var(--font-size-base);\n  font-weight: 600;\n}\n\n/* --- Status Tags ---------------------------------------------------- */\n.status-tag {\n  display: inline-flex;\n  align-items: center;\n  padding: 3px 10px;\n  border-radius: var(--radius-sm);\n  font-size: var(--font-size-xs);\n  font-weight: 600;\n  line-height: 1.4;\n}\n\n.status-tag--success {\n  background: var(--color-success-soft);\n  color: var(--color-success);\n}\n\n.status-tag--warning {\n  background: var(--color-warning-soft);\n  color: var(--color-warning);\n}\n\n.status-tag--danger {\n  background: var(--color-danger-soft);\n  color: var(--color-danger);\n}\n\n.status-tag--info {\n  background: var(--color-info-soft);\n  color: var(--color-info);\n}\n\n.status-tag--default {\n  background: var(--color-disabled-bg);\n  color: var(--color-text-muted);\n}\n\n/* Status pills (legacy class names) */\n.status-pill {\n  display: inline-flex;\n  align-items: center;\n  padding: 3px 10px;\n  border-radius: var(--radius-sm);\n  font-size: var(--font-size-xs);\n  font-weight: 600;\n  background: var(--color-info-soft);\n  color: var(--color-info);\n}\n\n.status-pill.ready,\n.status-pill.success,\n.status-pill.executed {\n  background: var(--color-success-soft);\n  color: var(--color-success);\n}\n\n.status-pill.failed,\n.status-pill.rejected {\n  background: var(--color-danger-soft);\n  color: var(--color-danger);\n}\n\n.status-pill.processing,\n.status-pill.pending {\n  background: var(--color-warning-soft);\n  color: var(--color-warning);\n}\n\n/* --- Auth Page ------------------------------------------------------ */\n.auth-page {\n  display: flex;\n  min-height: 100vh;\n}\n\n.auth-brand {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  width: 42%;\n  padding: var(--space-12);\n  background: var(--color-primary);\n  color: #ffffff;\n  position: relative;\n  overflow: hidden;\n}\n\n.auth-brand::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(135deg, rgba(25, 71, 84, 0.4) 0%, transparent 60%);\n}\n\n.auth-brand-content {\n  position: relative;\n  z-index: 1;\n  text-align: center;\n  max-width: 360px;\n}\n\n.auth-brand-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 64px;\n  height: 64px;\n  border-radius: var(--radius-xl);\n  background: rgba(255, 255, 255, 0.15);\n  margin: 0 auto var(--space-6);\n  font-size: 28px;\n}\n\n.auth-brand h2 {\n  font-size: 26px;\n  font-weight: 700;\n  margin-bottom: var(--space-3);\n  color: #ffffff;\n}\n\n.auth-brand p {\n  font-size: var(--font-size-md);\n  color: rgba(255, 255, 255, 0.8);\n  line-height: 1.7;\n}\n\n.auth-form-side {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: var(--space-8);\n  background: var(--color-bg-surface);\n}\n\n.auth-panel {\n  width: 100%;\n  max-width: 400px;\n}\n\n.auth-panel header {\n  margin-bottom: var(--space-6);\n}\n\n.auth-panel .auth-logo {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px;\n  height: 44px;\n  border-radius: var(--radius-lg);\n  background: var(--color-primary-soft);\n  color: var(--color-primary);\n  font-size: 22px;\n  margin-bottom: var(--space-4);\n}\n\n.auth-panel .eyebrow {\n  color: var(--color-text-muted);\n  font-size: var(--font-size-sm);\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  margin-bottom: var(--space-2);\n}\n\n.auth-panel h1 {\n  font-size: var(--font-size-2xl);\n  font-weight: 700;\n  margin-bottom: var(--space-1);\n}\n\n.auth-tabs {\n  width: 100%;\n  margin-bottom: var(--space-5);\n}\n\n.auth-form {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-4);\n}\n\n.auth-form .el-button {\n  height: 44px;\n  margin-top: var(--space-2);\n}\n\n.auth-security-note {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--space-2);\n  margin-top: var(--space-5);\n  color: var(--color-text-muted);\n  font-size: var(--font-size-sm);\n  line-height: 1.6;\n}\n\n.auth-security-note .el-icon {\n  flex-shrink: 0;\n  margin-top: 2px;\n  color: var(--color-text-muted);\n}\n\n/* --- Dashboard ------------------------------------------------------ */\n.dashboard {\n  max-width: 1100px;\n}\n\n.dashboard-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--space-6);\n  margin-bottom: var(--space-8);\n}\n\n.dashboard-header h1 {\n  font-size: var(--font-size-3xl);\n  margin-bottom: var(--space-2);\n}\n\n.dashboard-subtitle {\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-md);\n}\n\n.dashboard-stats {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: var(--space-4);\n  margin-bottom: var(--space-8);\n}\n\n.stat-card {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-2);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  background: var(--color-bg-surface);\n  padding: var(--space-5);\n  box-shadow: var(--shadow-sm);\n}\n\n.stat-card .stat-label {\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-sm);\n  font-weight: 600;\n}\n\n.stat-card .stat-value {\n  color: var(--color-primary);\n  font-size: var(--font-size-3xl);\n  font-weight: 700;\n  line-height: 1;\n}\n\n.stat-card .stat-value small {\n  font-size: var(--font-size-base);\n  font-weight: 400;\n  margin-left: 2px;\n}\n\n.stat-card .stat-desc {\n  color: var(--color-text-muted);\n  font-size: var(--font-size-xs);\n}\n\n.dashboard-links {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: var(--space-4);\n}\n\n.link-card {\n  display: flex;\n  align-items: center;\n  gap: var(--space-5);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  background: var(--color-bg-surface);\n  padding: var(--space-5);\n  box-shadow: var(--shadow-sm);\n  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);\n  text-decoration: none;\n  color: inherit;\n}\n\n.link-card:hover {\n  border-color: var(--color-primary-border);\n  box-shadow: var(--shadow-md);\n  color: inherit;\n}\n\n.link-card .link-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px;\n  height: 44px;\n  border-radius: var(--radius-lg);\n  background: var(--color-primary-soft);\n  color: var(--color-primary);\n  font-size: 22px;\n  flex-shrink: 0;\n}\n\n.link-card h2 {\n  margin-bottom: var(--space-1);\n  font-size: var(--font-size-lg);\n  color: var(--color-text-primary);\n}\n\n.link-card p {\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-sm);\n}\n\n/* --- Chat Workspace ------------------------------------------------- */\n.chat-workspace {\n  display: flex;\n  flex-direction: column;\n  height: calc(100vh - var(--topbar-height));\n  margin: calc(-1 * var(--space-6));\n  margin-bottom: calc(-1 * var(--space-6));\n}\n\n.chat-layout {\n  display: flex;\n  gap: var(--space-4);\n  flex: 1;\n  min-height: 0;\n  padding: var(--space-4) var(--space-6);\n}\n\n.conversation {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-4);\n  flex: 1;\n  min-height: 0;\n  overflow-y: auto;\n  padding: var(--space-1) var(--space-3) var(--space-1) 0;\n  scrollbar-gutter: stable;\n}\n\n.message {\n  display: grid;\n  grid-template-columns: 38px minmax(0, 1fr);\n  gap: var(--space-3);\n  max-width: 820px;\n}\n\n.message.user {\n  justify-self: end;\n}\n\n.message-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 38px;\n  height: 38px;\n  border-radius: var(--radius-lg);\n  background: var(--color-primary-soft);\n  color: var(--color-primary);\n  font-size: 20px;\n  flex-shrink: 0;\n}\n\n.message.user .message-icon {\n  background: var(--color-info-soft);\n  color: var(--color-info);\n}\n\n.message-body {\n  position: relative;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  background: var(--color-bg-surface);\n  padding: var(--space-4) 48px var(--space-4) var(--space-4);\n  box-shadow: var(--shadow-sm);\n}\n\n.message-body.pending {\n  color: var(--color-text-secondary);\n}\n\n.message.user .message-body {\n  background: var(--color-primary);\n  color: #ffffff;\n  border-color: var(--color-primary);\n}\n\n.message-copy {\n  position: absolute;\n  top: 9px;\n  right: 9px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 30px;\n  height: 30px;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  background: var(--color-bg-surface);\n  color: var(--color-text-muted);\n  cursor: pointer;\n  font-size: 16px;\n  opacity: 0.6;\n  transition: opacity var(--transition-fast), border-color var(--transition-fast);\n}\n\n.message-copy:hover,\n.message-copy:focus-visible {\n  border-color: var(--color-primary);\n  color: var(--color-primary);\n  opacity: 1;\n}\n\n.message.user .message-copy {\n  border-color: rgba(255, 255, 255, 0.24);\n  background: rgba(255, 255, 255, 0.1);\n  color: #ffffff;\n}\n\n.message.user .message-copy:hover,\n.message.user .message-copy:focus-visible {\n  border-color: rgba(255, 255, 255, 0.6);\n  background: rgba(255, 255, 255, 0.18);\n}\n\n.message-body p {\n  margin: 0;\n  white-space: pre-wrap;\n  line-height: 1.7;\n}\n\n.token-usage {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-2);\n  margin-top: var(--space-3);\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-xs);\n}\n\n.token-usage span,\n.token-usage strong {\n  border: 1px solid var(--color-border);\n  border-radius: 999px;\n  padding: 4px 8px;\n  background: var(--color-bg-page);\n}\n\n.token-usage strong {\n  color: var(--color-primary);\n}\n\n/* Supervisor card */\n.supervisor-card {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-2);\n  margin-top: var(--space-3);\n  border: 1px solid var(--color-primary-border);\n  border-radius: var(--radius-lg);\n  background: var(--color-primary-soft);\n  padding: var(--space-3);\n}\n\n.supervisor-card header {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-2);\n}\n\n.supervisor-card strong {\n  color: var(--color-primary);\n  font-size: var(--font-size-sm);\n}\n\n.supervisor-card span,\n.supervisor-card small {\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-xs);\n}\n\n.supervisor-card p {\n  color: var(--color-text-primary);\n  font-size: var(--font-size-sm);\n  line-height: 1.5;\n}