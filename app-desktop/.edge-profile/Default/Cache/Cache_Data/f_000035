idebar) */\n.agent-panel {\n  width: 320px;\n  flex-shrink: 0;\n  align-self: flex-start;\n  max-height: calc(100vh - var(--topbar-height) - var(--space-8));\n  overflow-y: auto;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  background: var(--color-bg-surface);\n  padding: var(--space-5);\n  box-shadow: var(--shadow-sm);\n}\n\n.agent-panel h2 {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n  margin: 0;\n  font-size: var(--font-size-xl);\n}\n\n.panel-actions {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-3);\n  margin-bottom: var(--space-4);\n}\n\n.history-list {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-2);\n  margin-bottom: var(--space-5);\n}\n\n.history-search {\n  margin-bottom: var(--space-4);\n}\n\n.token-card {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-2);\n  margin-bottom: var(--space-5);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  background: var(--color-bg-page);\n  padding: var(--space-4);\n}\n\n.token-card span,\n.token-card small {\n  color: var(--color-text-secondary);\n}\n\n.token-card strong {\n  color: var(--color-primary);\n  font-size: var(--font-size-3xl);\n  line-height: 1;\n}\n\n.agent-roster {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-2);\n  margin-bottom: var(--space-5);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  background: var(--color-bg-surface);\n  padding: var(--space-4);\n}\n\n.agent-roster h3 {\n  margin: 0 0 var(--space-1);\n  color: var(--color-text-primary);\n  font-size: var(--font-size-base);\n}\n\n.agent-roster article {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  border-top: 1px solid var(--color-divider);\n  padding-top: var(--space-2);\n}\n\n.agent-roster article:first-of-type {\n  border-top: 0;\n  padding-top: 0;\n}\n\n.agent-roster strong {\n  color: var(--colo