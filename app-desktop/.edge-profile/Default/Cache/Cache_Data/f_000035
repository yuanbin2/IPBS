display: grid;\n  grid-template-columns: minmax(0, 1fr) 112px;\n  gap: var(--space-3);\n  padding: var(--space-4) var(--space-6);\n  border-top: 1px solid var(--color-divider);\n  background: var(--color-bg-surface);\n  flex-shrink: 0;\n}\n\n.composer-actions {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-2);\n}\n\n.composer-actions .el-switch {\n  align-self: center;\n}\n\n.composer-actions .el-button {\n  width: 100%;\n  flex: 1;\n  height: 76px;\n}\n\n/* --- Knowledge Base ------------------------------------------------- */\n.knowledge-workspace {\n  min-height: 100vh;\n}\n\n.knowledge-layout {\n  display: grid;\n  grid-template-columns: 280px minmax(0, 1fr);\n  gap: var(--space-5);\n}\n\n.knowledge-panel,\n.upload-zone,\n.document-table,\n.search-lab {\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  background: var(--color-bg-surface);\n  padding: var(--space-5);\n  box-shadow: var(--shadow-sm);\n}\n\n.knowledge-panel {\n  align-self: start;\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-3);\n}\n\n.knowledge-base-row {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: var(--space-2);\n  align-items: stretch;\n}\n\n.knowledge-base-row.active .knowledge-base-button,\n.knowledge-base-row:hover .knowledge-base-button {\n  border-color: var(--color-primary);\n  color: var(--color-primary);\n}\n\n.knowledge-base-button {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-2);\n  width: 100%;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  background: var(--color-bg-surface);\n  padding: var(--space-3);\n  color: var(--color-text-primary);\n  cursor: pointer;\n  text-align: left;\n  transition: border-color var(--transition-fast), color var(--transition-fast);\n}\n\n.knowledge-base-button:hover {\n  border-color: var(--color-primary);\n  color: var(--color-primary);\n}\n\n.knowledge-base-button span {\n  color: var(--color-text-se