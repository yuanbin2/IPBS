# 历史 PythonAnywhere 配置，仅用于隔离演示，不符合当前生产安全验收要求。
# 它启用了 BLOG_LOCAL_MODE=true 和 AGENT_SECURITY_ENFORCED=false，严禁直接用于公网部署。
# 当前部署阻断项见 ../docs/缺陷跟踪表V2.0.md 的 B-003。

# 基本设置
DJANGO_SECRET_KEY=replace-with-a-private-token-url-safe-48-chars-or-longer
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com
BLOG_LOCAL_MODE=true
APP_TIMEZONE=Asia/Shanghai

# 数据库（使用 SQLite，PythonAnywhere 免费版不支持 PostgreSQL）
DATABASE_URL=sqlite:///home/yourusername/IPBS/backend/db.sqlite3

# 关闭需要 Redis/Celery 的功能
AGENT_SECURITY_ENFORCED=false

# OpenAI API（如果需要 AI 功能）
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_MODEL=gpt-4o-mini
